---
import tunnelJs from '../lib/tunnel.js?raw';

const html =
	'<meta name=viewport content="width=device-width"><title>Tunnel Racer</title>' +
	'<style>html,body{margin:0;height:100%;background:#000}canvas{display:block;width:100%;height:100%;cursor:crosshair;touch-action:none}</style>' +
	'<canvas id=tunnel></canvas><script>' + tunnelJs + '<\/script>';
const uri = 'data:text/html;charset=utf-8,' + encodeURIComponent(html);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Tunnel Racer – data URI</title>
		<style>
			body { font: 14px ui-monospace, monospace; margin: 2rem; background: #111; color: #eee; }
			textarea { width: 100%; height: 50vh; background: #000; color: #0ff; border: 1px solid #333; padding: 1rem; box-sizing: border-box; }
			a { color: #0ff; margin-right: 1rem; }
			button { font: inherit; padding: 0.5rem 1rem; margin-right: 1rem; }
		</style>
	</head>
	<body>
		<p><a href="/play">Play now</a> · <button id="copy">Copy</button><span>{uri.length.toLocaleString()} bytes · paste into the address bar</span></p>
		<textarea id="uri" readonly>{uri}</textarea>
		<script>
			const ta = document.getElementById('uri') as HTMLTextAreaElement;
			document.getElementById('copy')!.addEventListener('click', (e) => {
				navigator.clipboard.writeText(ta.value);
				(e.target as HTMLButtonElement).textContent = 'Copied';
			});
			ta.addEventListener('focus', () => ta.select());
		</script>
	</body>
</html>
